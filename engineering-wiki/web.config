<?xml version="1.0" encoding="UTF-8"?>
<!--
  The IIS half of the .htaccess beside this file. The Engineering wiki pages are
  read through api/system/engineering-wiki/ (administrators only), never served
  directly. "." refuses any URL with a dot in it - every .md file here. No
  <handlers><clear/>: that section is locked on a default IIS install and would
  turn this folder into a 500.19 (see recordings/web.config).
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <denyUrlSequences>
          <add sequence="." />
        </denyUrlSequences>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
