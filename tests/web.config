<?xml version="1.0" encoding="UTF-8"?>
<!--
  The developer test suite. NEVER reachable over HTTP. The IIS half of the
  .htaccess beside this file, which IIS does not read.

  These scripts run the real code against the real database — they create forms,
  assets, documents and working analyst accounts, and tidy up only if they reach
  the end. Over HTTP they are unauthenticated write endpoints that a request can
  abandon half way. See the .htaccess for the full reasoning.

  ⚠️ NO <handlers><clear/> here, and its absence is deliberate — the same trap
  documented in tickets/attachments/web.config. The handlers section is locked at
  server level on a default IIS install, so clearing it makes IIS answer HTTP
  500.19 for everything underneath. A directory that 500s has not been secured,
  it has been broken, and it reads to an operator as FreeITSM being at fault.

  denyUrlSequences is not a locked section and is enough: "." refuses any URL
  containing a dot, which is every file in this directory, with a clean 404.5.
  Nothing in here is ever meant to be fetched.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <denyUrlSequences>
          <add sequence="." />
        </denyUrlSequences>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
