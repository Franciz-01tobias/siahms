<?xml version="1.0" encoding="UTF-8"?>
<!--
  Uploaded content. NEVER executed, never served directly. The IIS half of the
  .htaccess beside this file, which IIS does not read.

  ⚠️ There is deliberately NO <handlers><clear/> here, and its absence is the fix
  rather than an omission. The handlers section is locked at server level on a
  default IIS install (overrideModeDefault="Deny"), so clearing it makes IIS refuse
  to read this file at all and answer HTTP 500.19 — "this configuration section
  cannot be used at this path" — for everything underneath. A directory that 500s
  has not been secured; it has been broken, and it reads to an operator as FreeITSM
  being at fault. Reported by Erlend Volden.

  denyUrlSequences alone is enough and is not a locked section: "." refuses any URL
  containing a dot, which is every file in this directory, with a clean 404.5. These
  files are served through the get_attachment.php endpoints, which authorise first
  and choose the Content-Type themselves.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <denyUrlSequences>
          <add sequence="." />
        </denyUrlSequences>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
